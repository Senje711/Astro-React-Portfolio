<!-- Sequential 5-Step Scroll Transition Script -->
<script>
  function setupSequentialAboutScroll() {
    const aboutSection = document.getElementById("about");
    if (!aboutSection) return;

    const card1 = aboutSection.querySelector(
      ".about-card-1",
    ) as HTMLElement | null; // about-me
    const card2 = aboutSection.querySelector(
      ".about-card-2",
    ) as HTMLElement | null; // portrait
    const card3 = aboutSection.querySelector(
      ".about-card-3",
    ) as HTMLElement | null; // where-i-work
    const card4 = aboutSection.querySelector(
      ".about-card-4",
    ) as HTMLElement | null; // hobbies
    const card5 = aboutSection.querySelector(
      ".about-card-5",
    ) as HTMLElement | null; // me-online

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const windowHeight = window.innerHeight;

          // Card 1 (About Me)
          if (card1) {
            const rect = card1.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 80) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 45;
            const scale = 0.95 + progress * 0.05;
            card1.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card1.style.opacity = `${progress}`;
          }

          // Card 2 (Portrait POP Animation)
          if (card2) {
            const rect = card2.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );

            // Bouncy Spring Pop Formula:
            let popScale: number;
            let rotate: number;
            if (progress <= 0.75) {
              const p = progress / 0.75;
              popScale = 0.35 + p * 0.83; // Starts tiny at 0.35 -> POPS to 1.18
              rotate = -12 + p * 16; // Rotates from -12deg -> +4deg
            } else {
              const p = (progress - 0.75) / 0.25;
              popScale = 1.18 - p * 0.18; // Settles from 1.18 -> 1.00
              rotate = 4 - p * 4; // Settles from +4deg -> 0deg
            }
            const y = (1 - progress) * 90;
            const opacity = Math.min(1, progress * 2.5);

            card2.style.transform = `translate3d(0, ${y}px, 0) scale(${popScale}) rotate(${rotate}deg)`;
            card2.style.opacity = `${opacity}`;
          }

          // Card 3 (Where I Work)
          if (card3) {
            const rect = card3.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 65;
            const scale = 0.9 + progress * 0.1;
            card3.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card3.style.opacity = `${progress}`;
          }

          // Card 4 (Hobbies)
          if (card4) {
            const rect = card4.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 75;
            const scale = 0.88 + progress * 0.12;
            card4.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card4.style.opacity = `${progress}`;
          }

          // Card 5 (Me Online)
          if (card5) {
            const rect = card5.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 75;
            const scale = 0.88 + progress * 0.12;
            card5.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card5.style.opacity = `${progress}`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  setupSequentialAboutScroll();
  document.addEventListener("astro:page-load", setupSequentialAboutScroll);

  // ---------- Typewriter effect for the IDE windows ----------
  type TypeItem = { node: Text; rest: HTMLElement; chars: string[] };

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function splitChars(text: string): string[] {
    const Seg = (Intl as any).Segmenter;
    if (Seg) {
      return Array.from(
        new Seg(undefined, { granularity: "grapheme" }).segment(text),
        (s: any) => s.segment as string,
      );
    }
    return Array.from(text);
  }

  function prepareCard(card: HTMLElement): TypeItem[][] {
    const lines = card.querySelectorAll<HTMLElement>("[data-tw-line]");
    return Array.from(lines).map((line) => {
      const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);

      const items: TypeItem[] = [];
      for (const node of nodes) {
        const full = node.data;
        if (!full.trim()) continue; // leave whitespace-only nodes untouched
        // Keep the untyped remainder in the DOM (hidden) so layout never shifts
        const rest = document.createElement("span");
        rest.className = "tw-rest";
        rest.textContent = full;
        node.data = "";
        node.after(rest);
        items.push({ node, rest, chars: splitChars(full) });
      }
      return items;
    });
  }

  async function typeCard(card: HTMLElement, lines: TypeItem[][]) {
    const speed = Number(card.dataset.twSpeed) || 20;
    const caret = document.createElement("span");
    caret.className = "tw-caret tw-typing";
    caret.setAttribute("aria-hidden", "true");

    for (const items of lines) {
      for (const it of items) {
        it.rest.before(caret);
        for (let i = 0; i < it.chars.length; i++) {
          const ch = it.chars[i];
          it.node.data += ch;
          it.rest.textContent = it.chars.slice(i + 1).join("");
          if (/\S/.test(ch)) {
            const pause = /[.,!]/.test(ch) ? speed * 6 : speed;
            await sleep(pause + Math.random() * speed * 0.6);
          }
        }
        it.rest.remove();
        it.node.after(caret);
      }
      await sleep(speed * 10);
    }

    // Leave a blinking caret at the end briefly (doesn't block the next card)
    caret.classList.remove("tw-typing");
    setTimeout(() => caret.remove(), 1500);
  }

  // Resolves once the card has scrolled into view
  function whenVisible(card: HTMLElement): Promise<void> {
    return new Promise((resolve) => {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            observer.disconnect();
            resolve();
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(card);
    });
  }

  async function setupAboutTypewriter() {
    const section = document.getElementById("about");
    if (!section || section.dataset.twInit) return;
    section.dataset.twInit = "1";

    // Type strictly one window at a time, in data-tw-order:
    // about-me → background → me-online → hobbies
    const cards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-typewriter]"),
    ).sort(
      (a, b) => Number(a.dataset.twOrder ?? 0) - Number(b.dataset.twOrder ?? 0),
    );
    const prepared = cards.map((card) => ({ card, lines: prepareCard(card) }));

    for (const { card, lines } of prepared) {
      await whenVisible(card);
      await typeCard(card, lines);
      await sleep(250);
    }
  }

  setupAboutTypewriter();
  document.addEventListener("astro:page-load", setupAboutTypewriter);
</script>

<style is:global>
  #about .tw-rest {
