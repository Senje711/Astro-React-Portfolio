    width: 0;
    height: 1em;
    vertical-align: text-bottom;
  }
  #about .tw-caret::after {
    content: "";
    position: absolute;
    left: 1px;
    top: 0;
    width: 2px;
    height: 1.2em;
    background: #a3e635;
    box-shadow: 0 0 8px rgba(163, 230, 53, 0.7);
    animation: tw-blink 1s steps(1) infinite;
  }
  #about .tw-caret.tw-typing::after {
    animation: none;
  }
  @keyframes tw-blink {
    50% {
      opacity: 0;
    }
  }
</style>
