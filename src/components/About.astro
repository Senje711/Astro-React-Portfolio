          >
            <span>—</span>
            <span>□</span>
            <span>✕</span>
          </div>
        </div>

        <!-- Body -->
        <div class="p-4 space-y-2 text-xs sm:text-sm text-gray-300">
          <div class="flex items-center gap-3">
            <span class="text-gray-600 font-mono select-none w-4 text-right"
