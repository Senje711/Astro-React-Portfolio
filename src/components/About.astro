            >
          </div>
          <div class="flex items-center gap-3">
            <span class="text-gray-600 font-mono select-none w-4 text-right"
              >2</span
            >
            <span class="flex items-center gap-1.5"
              ><span class="text-base">🏀</span> <span>Basketball</span></span
            >
          </div>
          <div class="flex items-center gap-3">
            <span class="text-gray-600 font-mono select-none w-4 text-right"
              >3</span
            >
            <span class="flex items-center gap-1.5"
              ><span class="text-base">🚴</span> <span>Biking</span></span
            >
          </div>
          <div class="flex items-center gap-3">
            <span class="text-gray-600 font-mono select-none w-4 text-right"
              >4</span
