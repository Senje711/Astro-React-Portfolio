</section>

<!-- Sequential 5-Step Scroll Transition Script -->
<script>
  function setupSequentialAboutScroll() {
    const aboutSection = document.getElementById("about");
    if (!aboutSection) return;

    const card1 = aboutSection.querySelector(
      ".about-card-1",
    ) as HTMLElement | null; // about-me
    const card2 = aboutSection.querySelector(
      ".about-card-2",
    ) as HTMLElement | null; // portrait
    const card3 = aboutSection.querySelector(
      ".about-card-3",
    ) as HTMLElement | null; // where-i-work
    const card4 = aboutSection.querySelector(
      ".about-card-4",
    ) as HTMLElement | null; // hobbies
    const card5 = aboutSection.querySelector(
      ".about-card-5",
    ) as HTMLElement | null; // me-online

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const windowHeight = window.innerHeight;

          // Card 1 (About Me)
          if (card1) {
            const rect = card1.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 80) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 45;
            const scale = 0.95 + progress * 0.05;
            card1.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card1.style.opacity = `${progress}`;
          }

          // Card 2 (Portrait POP Animation)
          if (card2) {
            const rect = card2.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );

            // Bouncy Spring Pop Formula:
            let popScale: number;
            let rotate: number;
            if (progress <= 0.75) {
              const p = progress / 0.75;
              popScale = 0.35 + p * 0.83; // Starts tiny at 0.35 -> POPS to 1.18
              rotate = -12 + p * 16; // Rotates from -12deg -> +4deg
            } else {
              const p = (progress - 0.75) / 0.25;
              popScale = 1.18 - p * 0.18; // Settles from 1.18 -> 1.00
              rotate = 4 - p * 4; // Settles from +4deg -> 0deg
            }
            const y = (1 - progress) * 90;
            const opacity = Math.min(1, progress * 2.5);

            card2.style.transform = `translate3d(0, ${y}px, 0) scale(${popScale}) rotate(${rotate}deg)`;
            card2.style.opacity = `${opacity}`;
          }

          // Card 3 (Where I Work)
          if (card3) {
            const rect = card3.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 65;
            const scale = 0.9 + progress * 0.1;
            card3.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card3.style.opacity = `${progress}`;
          }

          // Card 4 (Hobbies)
          if (card4) {
            const rect = card4.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 75;
            const scale = 0.88 + progress * 0.12;
            card4.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card4.style.opacity = `${progress}`;
          }

          // Card 5 (Me Online)
          if (card5) {
            const rect = card5.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(
                0,
                (windowHeight - rect.top + 160) / (windowHeight * 0.5),
              ),
            );
            const y = (1 - progress) * 75;
            const scale = 0.88 + progress * 0.12;
            card5.style.transform = `translate3d(0, ${y}px, 0) scale(${scale})`;
            card5.style.opacity = `${progress}`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  setupSequentialAboutScroll();
  document.addEventListener("astro:page-load", setupSequentialAboutScroll);
</script>
