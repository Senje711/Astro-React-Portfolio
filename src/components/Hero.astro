---
// src/components/Hero.astro
---

<section id="home" class="relative min-h-[95vh] flex flex-col justify-between items-center pt-16 pb-12 overflow-hidden select-none">
  <!-- Subtle Background Watermark Text -->
  <div class="hero-watermark absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.035] z-0 overflow-hidden transition-transform duration-75 ease-out">
    <span class="text-[22vw] font-extrabold font-sans tracking-tighter text-white uppercase whitespace-nowrap">
      DEVELOPER
    </span>
  </div>

  <!-- Ambient Glow Blobs -->
  <div class="absolute -bottom-20 -left-20 w-[550px] h-[550px] bg-emerald-500/20 rounded-full blur-[160px] pointer-events-none z-0"></div>
  <div class="absolute top-10 right-0 w-[500px] h-[500px] bg-lime-500/15 rounded-full blur-[160px] pointer-events-none z-0"></div>

  <!-- Floating 3D Code Symbols framing the headline closely -->
  <!-- Left Curly Brace { -->
  <div class="hero-float-wrapper absolute top-[20%] left-[4%] sm:left-[12%] lg:left-[18%] pointer-events-none z-10 transition-transform duration-75 ease-out">
    <div class="hero-float animate-float-1 text-gray-700/40 sm:text-gray-700/80 font-mono text-4xl sm:text-7xl lg:text-9xl font-black drop-shadow-2xl select-none">
      &#123;
    </div>
  </div>

  <!-- Right Slash / -->
  <div class="hero-float-wrapper absolute top-[22%] right-[4%] sm:right-[12%] lg:right-[18%] pointer-events-none z-10 transition-transform duration-75 ease-out">
    <div class="hero-float animate-float-2 text-gray-700/40 sm:text-gray-700/80 font-mono text-3xl sm:text-6xl lg:text-8xl font-black drop-shadow-2xl select-none">
      /
    </div>
  </div>

  <!-- Bottom Left Asterisk * -->
  <div class="hero-float-wrapper absolute bottom-[26%] left-[5%] sm:left-[14%] lg:left-[20%] pointer-events-none z-10 transition-transform duration-75 ease-out">
    <div class="hero-float animate-float-3 text-gray-700/40 sm:text-gray-700/80 font-mono text-3xl sm:text-6xl lg:text-8xl font-black drop-shadow-2xl select-none">
      *
    </div>
  </div>

  <!-- Bottom Right Greater-Than > -->
  <div class="hero-float-wrapper absolute bottom-[24%] right-[5%] sm:right-[14%] lg:right-[20%] pointer-events-none z-10 transition-transform duration-75 ease-out">
    <div class="hero-float animate-float-1 text-gray-700/40 sm:text-gray-700/80 font-mono text-4xl sm:text-7xl lg:text-9xl font-black drop-shadow-2xl select-none">
      &gt;
    </div>
  </div>

  <!-- Top Label -->
  <div class="hero-top-tag relative z-20 pt-4 transition-transform duration-75 ease-out">
    <span class="text-[10px] sm:text-[11px] font-mono tracking-[0.2em] sm:tracking-[0.3em] uppercase text-gray-400 bg-gray-900/60 px-3 py-1 rounded-full border border-gray-800/60 backdrop-blur-md">
      4TH YEAR COLLEGE STUDENT
    </span>
  </div>

  <!-- Main Center Content -->
  <div class="relative z-20 max-w-4xl mx-auto px-4 text-center space-y-6 sm:space-y-8 my-auto py-8 sm:py-12">
    
    <!-- Big Headline -->
    <div class="hero-title transition-transform duration-75 ease-out">
     <h1
  class="scramble-headline text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-extrabold tracking-tight text-white leading-[1.1] sm:leading-[1.08] font-sans"
  aria-label="Hi, I'm Jesenhower, an aspiring Software Engineer"
>
  <span data-scramble data-scramble-text="Hi, I'm Jesenhower, an ">▓K#R1&Q</span>
  <br />
  <span class="headline-row inline-flex items-baseline whitespace-nowrap">
    <span data-scramble data-scramble-text="aspiring" class="text-lime-400">▓K#R1&Q</span>
    <span>&nbsp;</span>
    <span data-scramble data-scramble-text="Software">▓K#R1&Q</span>
  </span>
  <br />
  <span data-scramble data-scramble-text="Engineer" class="headline-role">▓K#R1&Q</span>
</h1>
    </div>

    <!-- Subtitle -->
    <div class="hero-subtitle transition-transform duration-75 ease-out">
      <p class="font-mono text-xs sm:text-sm md:text-base text-gray-300 max-w-xl mx-auto leading-relaxed tracking-wide">
        I bring value to web development projects by merging technical expertise with creativity and aesthetics.
      </p>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a
        href="#projects"
        class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-xs sm:text-sm text-black bg-lime-400 hover:bg-lime-300 shadow-lg shadow-lime-500/20 transition-all duration-200 hover:scale-[1.02]"
      >
        Explore Work
      </a>
      <a
        href="#contact"
        class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-xs sm:text-sm text-gray-200 glass-panel border border-gray-700/80 hover:text-white hover:border-lime-400/50 hover:bg-gray-800/80 transition-all duration-200 hover:scale-[1.02]"
      >
        Connect with Me
      </a>
    </div>

  </div>

  <!-- Bottom Glowing Vertical Scroll Cue Line -->
  <div class="hero-scroll-cue relative z-20 flex flex-col items-center gap-2 pt-6 transition-opacity duration-200">
    <a href="#about" aria-label="Scroll to about" class="group flex flex-col items-center">
      <div class="w-[2px] h-12 bg-gradient-to-b from-transparent via-lime-400 to-transparent group-hover:h-16 transition-all duration-300 rounded-full shadow-[0_0_10px_#a3e635]"></div>
    </a>
  </div>

</section>

<script>
  const SCRAMBLE_CHARACTERS =
    '▓▒░#*&ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

  function createScrambledText(text: string) {
    return text
      .split('')
      .map((character) => {
        if (character === ' ') return ' ';

        return SCRAMBLE_CHARACTERS[
          Math.floor(Math.random() * SCRAMBLE_CHARACTERS.length)
        ];
      })
      .join('');
  }

  function scrambleHeadline(element: HTMLElement, onComplete?: () => void) {
    const finalText = element.dataset.scrambleText || '';
    element.textContent = createScrambledText(finalText);

    let revealedCharacters = 0;
    let intervalId: number;

    intervalId = window.setInterval(() => {
      const output = finalText
        .split('')
        .map((character, index) => {
          if (character === ' ') return ' ';
          if (index < revealedCharacters) return character;

          return SCRAMBLE_CHARACTERS[
            Math.floor(Math.random() * SCRAMBLE_CHARACTERS.length)
          ];
        })
        .join('');

      element.textContent = output;
      revealedCharacters += 1;

      if (revealedCharacters > finalText.length) {
        window.clearInterval(intervalId);
        element.textContent = finalText;
        onComplete?.();
      }
    }, 90);
  }

  function setupScramble() {
    const elements =
      document.querySelectorAll<HTMLElement>('[data-scramble]');

    if (
      elements.length === 0 ||
      elements[0].dataset.scrambleStarted === 'true'
    ) return;

    elements.forEach((element) => {
      element.dataset.scrambleStarted = 'true';
    });

    const startSequence = () => {
      window.setTimeout(() => {
        scrambleHeadline(elements[0], () => {
          scrambleHeadline(elements[1], () => {
            scrambleHeadline(elements[2], () => {
              scrambleHeadline(elements[3]);
            });
          });
        });
      }, 250);
    };

    if (!document.querySelector('[class*="z-[9999]"]')) {
      startSequence();
      return;
    }

    const observer = new MutationObserver(() => {
      if (document.querySelector('[class*="z-[9999]"]')) return;

      observer.disconnect();
      startSequence();
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupScramble();
  document.addEventListener('astro:page-load', setupScramble);
</script>

