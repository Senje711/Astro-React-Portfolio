---
// src/components/BackToTop.astro
// Floating "back to top" button with a scroll-progress ring.
// Sits just above the chatbot button; glows when you reach the bottom.
---

<button
  id="back-to-top"
  type="button"
  aria-label="Scroll back to top"
  title="Back to top"
  class="back-to-top fixed z-[9985] bottom-[84px] right-[22px] sm:bottom-[92px] sm:right-[30px] w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#080d08]/95 border border-gray-800 text-lime-400 shadow-2xl shadow-black/70 backdrop-blur-md flex items-center justify-center cursor-pointer hover:border-lime-500/60"
>
  <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 44 44" aria-hidden="true">
    <circle cx="22" cy="22" r="20" fill="none" stroke="rgba(163,230,53,0.12)" stroke-width="2"></circle>
    <circle
      id="back-to-top-ring"
      cx="22"
      cy="22"
      r="20"
      fill="none"
      stroke="#a3e635"
      stroke-width="2"
      stroke-linecap="round"
      stroke-dasharray="125.66"
      stroke-dashoffset="125.66"></circle>
  </svg>
  <svg class="relative w-4 h-4 sm:w-[18px] sm:h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
  </svg>
</button>

<style>
  .back-to-top {
    opacity: 0;
    translate: 0 16px;
    pointer-events: none;
    transition:
      opacity 0.3s ease-out,
      translate 0.3s ease-out,
      scale 0.2s ease-out,
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .back-to-top.is-visible {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  .back-to-top.is-visible:hover {
    scale: 1.1;
  }
  .back-to-top.is-visible:active {
    scale: 0.95;
  }
  .back-to-top.at-bottom {
    border-color: rgba(163, 230, 53, 0.7);
    box-shadow: 0 0 22px rgba(163, 230, 53, 0.35);
    animation: btt-nudge 1.6s ease-in-out infinite;
  }
  @keyframes btt-nudge {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -4px; }
  }
</style>

<script>
  const CIRC = 125.66;

  function setupBackToTop() {
    const btn = document.getElementById("back-to-top");
    const ring = document.getElementById("back-to-top-ring");
    if (!btn || !ring || btn.dataset.ready) return;
    btn.dataset.ready = "1";

    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const y = window.scrollY;
      const progress = max > 0 ? Math.min(1, y / max) : 0;
      ring.setAttribute("stroke-dashoffset", String(CIRC * (1 - progress)));
      btn.classList.toggle("is-visible", y > 400);
      btn.classList.toggle("at-bottom", max > 0 && max - y < 120);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    window.addEventListener("resize", update, { passive: true });
    update();

    btn.addEventListener("click", () => {
      const lenis = (window as any).__lenis;
      if (lenis) {
        lenis.scrollTo(0, {
          duration: 1.6,
          easing: (t: number) => 1 - Math.pow(1 - t, 4),
        });
      } else {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  }

  setupBackToTop();
  document.addEventListener("astro:page-load", setupBackToTop);
</script>
